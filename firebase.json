{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8085
    },
    "auth": {
      "port": 9099
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "hosting": {
    "public": "web",
    "ignore": [
      "**/.*"
    ],
    "cleanUrls": false,
    "redirects": [
      {
        "source": "/",
        "destination": "/grow/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/store/**",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "https://play.google.com"
          }
        ]
      },
      {
        "source": "/grow/**",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ]
  }
}